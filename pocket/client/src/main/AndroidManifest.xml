<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET permission is requested for anything except talking
         to the paired hub over its own WireGuard tunnel (infra/wireguard-poc/,
         infra/headscale/) — no other network access this app makes is
         legitimate, per CLAUDE.md's "no cloud calls, ever" principle. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="NEx Pocket"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.NexPocket">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
